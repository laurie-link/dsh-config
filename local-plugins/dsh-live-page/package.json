{
  "name": "dsh-live-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edit rendered workspace HTML pages inside the DSH IDE browser and give the agent live page/selection context.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "assets",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CONTRACT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/*.js",
    "test": "node --test tests/*.test.mjs"
  }
}
