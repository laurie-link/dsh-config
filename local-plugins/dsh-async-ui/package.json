{
  "name": "@local/dsh-async-ui",
  "version": "0.1.0",
  "private": true,
  "description": "AsyncImage-style render_ui for DSH: the model writes an image description (query), the host turns it into a resolvable URL, and GenUI's own card renderer draws it.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
